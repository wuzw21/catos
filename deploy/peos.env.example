HOST=0.0.0.0
PORT=2333
NODE_ENV=production
TZ=Asia/Shanghai
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

PEOS_CONTENT_ROOT=/srv/peos/content

# Tailscale private HTTP deployment. Switch both to 1 only after adding a real HTTPS domain.
PEOS_COOKIE_SECURE=0
PEOS_REQUIRE_HTTPS=0

PEOS_COUPLE_SESSION_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
PEOS_COUPLE_YOU_NAME=you
PEOS_COUPLE_PARTNER_NAME=partner
PEOS_COUPLE_YOU_PASSWORD=CHANGE_ME_YOU_PASSWORD
PEOS_COUPLE_PARTNER_PASSWORD=CHANGE_ME_PARTNER_PASSWORD

PEOS_LOGIN_RATE_LIMIT_MAX_FAILURES=6
PEOS_LOGIN_RATE_LIMIT_WINDOW_MS=600000
PEOS_LOGIN_RATE_LIMIT_LOCK_MS=900000

PEOS_COUPLE_DAILY_SUMMARY_CRON=1
PEOS_COUPLE_DAILY_SUMMARY_HOUR=4
PEOS_COUPLE_DAILY_SUMMARY_CRON_TARGET=yesterday
PEOS_COUPLE_DAILY_SUMMARY_AGENT=1

# The peos systemd service runs Codex as the service user.
CODEX_HOME=/home/peos/.codex
OTEL_SDK_DISABLED=true
